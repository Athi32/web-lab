        </p>


        <a
            class="store-link"
            href="https://www.google.com"
            target="_blank">

            Visit ComicVerse

        </a>

    </div>


    <!-- FOOTER -->

    <footer>

        <p>
            © 2026 ComicVerse | Premium Comic Book Store
        </p>

        <p>
            Designed using HTML5 & CSS3
        </p>

    </footer>


</body>

</html>
