<!DOCTYPE html>
<html lang="en">

<head>

    <!-- HTML5 DOCUMENT INFORMATION -->

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>ComicVerse | CSS3 Comic Book Store</title>


    <!-- CSS3 STYLING -->

    <style>

        /* ---------- NORMAL FLOW / BODY ---------- */

        body {
            margin: 0;
            padding: 0;
            background-color: #120b1f;
            color: #f5e9d0;
            font-family: Georgia, Garamond, serif;
        }


        /* ---------- HEADER ---------- */

        header {
            width: 100%;
            height: 230px;

            background-color: #24103f;

            background-image:
                url("https://images.unsplash.com/photo-1608889825103-eb5ed706fc64");

            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;

            text-align: center;

            padding-top: 40px;

            box-sizing: border-box;
        }


        header h1 {
            color: #ffd166;

            font-size: 48px;

            font-weight: bolder;

            letter-spacing: 6px;

            text-shadow:
                4px 4px 8px #000000;

            margin-top: 20px;

            margin-bottom: 10px;
        }


        header p {
            color: white;

            font-size: 20px;

            font-style: italic;

            letter-spacing: 2px;
        }


        /* ---------- NAVIGATION ---------- */

        nav {
            background-color: #08050d;

            padding: 18px;

            text-align: center;
        }


        nav a {
            display: inline;

            padding: 12px 20px;

            margin: 5px;

            font-family: Arial, sans-serif;

            font-weight: bold;

            text-decoration: none;

            border-radius: 6px;
        }


        /* Unvisited link */

        nav a:link {
            color: #ffd166;
            background-color: #21142f;
        }


        /* Visited link */

        nav a:visited {
            color: #ffcf70;
        }


        /* Mouse hover */

        nav a:hover {
            color: #ffffff;
            background-color: #ff7b00;
        }


        /* Active link */

        nav a:active {
            color: #21142f;
            background-color: #ffd166;
        }


        /* ---------- NORMAL FLOW SECTION ---------- */

        .section {
            margin-top: 30px;
            margin-bottom: 30px;
            margin-left: 50px;
            margin-right: 50px;

            padding-top: 25px;
            padding-bottom: 25px;
            padding-left: 30px;
            padding-right: 30px;

            background-color: #21142f;

            border-radius: 15px;
        }


        /* ---------- HEADINGS ---------- */

        h2 {
            color: #ffd166;

            font-size: 30px;

            text-align: left;

            text-decoration: underline;

            letter-spacing: 2px;

            text-shadow: 2px 2px 4px #000000;
        }


        h3 {
            color: #ff9f1c;

            font-size: 22px;

            font-weight: bold;
        }


        /* ---------- PARAGRAPH FORMATTING ---------- */

        .intro {
            margin-top: 25px;

            margin-bottom: 25px;

            font-size: 18px;

            line-height: 1.8;

            text-align: justify;

            letter-spacing: 1px;
        }


        /* ---------- IMAGE ---------- */

        .store-image {
            display: block;

            width: 70%;

            height: 300px;

            object-fit: cover;

            margin-top: 25px;

            margin-bottom: 25px;

            margin-left: auto;

            margin-right: auto;

            padding: 8px;

            background-color: #ffd166;

            border-radius: 15px;
        }


        /* ---------- COMIC CARDS ---------- */

        .comic-container {
            display: flex;

            justify-content: center;

            gap: 25px;

            flex-wrap: wrap;
        }


        .comic-card {
            display: block;

            width: 250px;

            min-height: 380px;

            padding: 20px;

            background-color: #302044;

            border-radius: 12px;

            text-align: center;

            box-sizing: border-box;
        }


        .comic-card:hover {
            background-color: #3d2855;

            transform: translateY(-5px);
        }


        .comic-card img {
            width: 100%;

            height: 220px;

            object-fit: cover;

            border-radius: 8px;
        }


        .comic-card h3 {
            letter-spacing: 1px;
        }


        /* ---------- MULTI COLUMN LAYOUT ---------- */

        .multi-column {
            column-count: 3;

            column-gap: 40px;

            column-rule: 2px solid #8064a2;

            padding: 25px;

            background-color: #302044;

            text-align: justify;

            line-height: 1.7;
        }


        .multi-column h3 {
            break-before: avoid;
        }


        /* ---------- LIST ---------- */

        ul {
            list-style-type: circle;

            padding-left: 30px;
        }


        ol {
            list-style-type: upper-roman;

            padding-left: 30px;
        }


        li {
            margin-bottom: 10px;

            padding: 3px;
        }


        /* ---------- LINK SECTION ---------- */

        .store-link {
            display: block;

            width: 200px;

            padding: 15px;

            margin: 20px auto;

            text-align: center;

            text-decoration: none;

            font-weight: bold;

            background-color: #ff7b00;

            color: white;

            border-radius: 8px;
        }


        .store-link:hover {
            background-color: #ffd166;

            color: #21142f;
        }


        /* ---------- FOOTER ---------- */

        footer {
            width: 100%;

            padding-top: 25px;
            padding-bottom: 25px;

            background-color: #08050d;

            color: #ffd166;

            text-align: center;

            font-family: Arial, sans-serif;
        }


        footer p {
            margin: 8px;
        }


        /* ---------- RESPONSIVE DESIGN ---------- */

        @media screen and (max-width: 800px) {

            .multi-column {
                column-count: 2;
            }

            .section {
                margin-left: 20px;
                margin-right: 20px;
            }

        }


        @media screen and (max-width: 500px) {

            .multi-column {
                column-count: 1;
            }

            header h1 {
                font-size: 32px;
            }

            nav a {
                display: block;

                margin: 8px;
            }

        }

    </style>

</head>


<body>


    <!-- HEADER SECTION -->

    <header>

        <h1>⚡ COMICVERSE ⚡</h1>

        <p>
            Where Every Page Begins an Adventure
        </p>

    </header>


    <!-- NAVIGATION SECTION -->

    <nav>

        <a href="#home">Home</a>

        <a href="#collection">Collection</a>

        <a href="#categories">Categories</a>

        <a href="#about">About</a>

    </nav>


